#include <stdio.h>
#include <string.h>

int isPalindrome(char str[], int start, int end)
{
    while (start < end)
    {
        if (str[start] != str[end])
            return 0;

        start++;
        end--;
    }

    return 1;
}

int main()
{
    char str[100];
    int i, j;
    int maxLen = 1, start = 0;

    printf("Enter a string: ");
    scanf("%s", str);

    int n = strlen(str);

    for (i = 0; i < n; i++)
    {
        for (j = i; j < n; j++)
        {
            if (isPalindrome(str, i, j))
            {
                if (j - i + 1 > maxLen)
                {
                    maxLen = j - i + 1;
                    start = i;
                }
            }
        }
    }

    printf("Longest Palindromic Substring: ");

    for (i = start; i < start + maxLen; i++)
        printf("%c", str[i]);

    return 0;
}
